{
  "name": "kode-bank-indonesia",
  "version": "0.0.0",
  "description": "Indonesian banks and e-wallets with bank codes and BICs, as a static JSON API and a typed npm package",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "indonesia",
    "bank",
    "bank-code",
    "kode-bank",
    "sandi-bank",
    "bic",
    "swift",
    "bi-fast",
    "e-wallet",
    "ewallet"
  ],
  "homepage": "https://dna-ardhi.github.io/kode-bank-indonesia/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dna-ardhi/kode-bank-indonesia.git"
  },
  "bugs": "https://github.com/dna-ardhi/kode-bank-indonesia/issues",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "validate": "node scripts/validate.ts",
    "test": "node scripts/build.ts && vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "sync:fetch": "node scripts/sync/fetch-sources.ts",
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts && tsc -p tsconfig.build.json",
    "build:lib": "tsc -p tsconfig.build.json",
    "sync:diff": "node scripts/sync/diff.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
