{
  "name": "kode-bank-indonesia",
  "version": "1.0.0",
  "description": "Indonesian banks and e-wallets with bank codes and BICs, as a static JSON API",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://dna-ardhi.github.io/kode-bank-indonesia/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dna-ardhi/kode-bank-indonesia.git"
  },
  "bugs": "https://github.com/dna-ardhi/kode-bank-indonesia/issues",
  "scripts": {
    "validate": "node scripts/validate.ts",
    "test": "node scripts/build.ts && vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "sync:fetch": "node scripts/sync/fetch-sources.ts",
    "build": "node scripts/build.ts",
    "sync:diff": "node scripts/sync/diff.ts",
    "docs:dev": "node scripts/docs.ts dev",
    "docs:build": "node scripts/docs.ts build"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.43.1",
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "astro": "7.4.13",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
